#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-origin}"
zero_oid="0000000000000000000000000000000000000000"
head_oid="$(git rev-parse HEAD)"
format_base=""
branch_update_seen=false

while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$remote_ref" != refs/heads/* ]]; then
        continue
    fi

    if [[ "$remote_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/dev" ]]; then
        echo "Direct pushes to ${remote_ref#refs/heads/} are not allowed; open a pull request instead." >&2
        exit 1
    fi

    if [[ "$local_oid" == "$zero_oid" ]]; then
        continue
    fi

    if [[ "$branch_update_seen" == true ]]; then
        echo "The pre-push style hook verifies one branch at a time; push branches separately." >&2
        exit 1
    fi
    branch_update_seen=true

    if [[ "$local_oid" != "$head_oid" ]]; then
        echo "The pre-push style hook can only verify the checked-out HEAD." >&2
        echo "Check out $local_ref and push it separately." >&2
        exit 1
    fi

    if [[ "$remote_oid" != "$zero_oid" ]] \
        && git rev-parse --verify --quiet "${remote_oid}^{commit}" >/dev/null \
        && git merge-base "$remote_oid" HEAD >/dev/null; then
        format_base="$remote_oid"
    fi
done

if [[ "$branch_update_seen" == false ]]; then
    exit 0
fi

if [[ -z "$format_base" ]]; then
    remote_dev="refs/remotes/${remote_name}/dev"
    if git rev-parse --verify --quiet "${remote_dev}^{commit}" >/dev/null \
        && git merge-base "$remote_dev" HEAD >/dev/null; then
        format_base="$remote_dev"
    elif git rev-parse --verify --quiet HEAD^ >/dev/null; then
        format_base="HEAD^"
    else
        format_base="HEAD"
    fi
fi

if command -v nproc >/dev/null 2>&1; then
    tidy_jobs="$(nproc)"
elif command -v sysctl >/dev/null 2>&1; then
    tidy_jobs="$(sysctl -n hw.logicalcpu 2>/dev/null || echo 1)"
else
    tidy_jobs=1
fi

repo_root="$(git rev-parse --show-toplevel)"
echo "Running C++ style checks before push (format base: $format_base)"
exec "$repo_root/lint_cpp_style.sh" --format-base "$format_base" --tidy-jobs "$tidy_jobs"
