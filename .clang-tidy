---
Checks: '-*,readability-identifier-naming'
HeaderFilterRegex: '(^|.*/)(default_planner|python/common|src|tests)/.*|(^|.*/)inc/[^/]+\.(h|hpp|hh)$'
CheckOptions:
  # Naming is intentionally stricter for new implementation details than for
  # the participant-facing and legacy surfaces. Existing spellings are listed
  # as exclusions instead of being renamed as part of the lint rollout.
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.ClassIgnoredRegexp
    value: '^(pyMAPFPlanner|pyTaskScheduler|pyExecutor|pyEntry|s_node|pqueue)$'
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.StructIgnoredRegexp
    value: '^(d2p|min_q|cmp_less_f|cmp_less_of|PIBT_C|compare_node|FW_Metric|max_q|s_node|equal_search_node|re_f|re_jam|re_of)$'
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.EnumIgnoredRegexp
    value: '^heuristics_type$'
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.FunctionIgnoredRegexp
    value: '^(main|validateMove|manhattanDistance|getNeighbors|getNeighbors_nowait|getNeighborLocs|causalPIBT|getAction|moveCheck|validMove)$'
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  # Compatibility callbacks keep their documented names so existing C++ and
  # Python participants do not need API changes:
  # - Entry::initialize, Entry::compute
  # - MAPFPlanner::initialize, MAPFPlanner::plan
  # - TaskScheduler::initialize, TaskScheduler::plan
  # - Executor::initialize, Executor::process_new_plan, Executor::next_command
  # The same method names are used by the Python bridge classes.
  # clang-tidy exclusions are name-based, not class-qualified.
  - key: readability-identifier-naming.MethodIgnoredRegexp
    value: '^(initialize|plan|compute|process_new_plan|next_command|nextTick|saveResults)$'

  # Deferred naming rules. Keep these commented until we decide whether the
  # churn is worth enforcing.
  # - key: readability-identifier-naming.TypedefCase
  #   value: CamelCase
  # - key: readability-identifier-naming.TypeAliasCase
  #   value: CamelCase
  # - key: readability-identifier-naming.TypeAliasIgnoredRegexp
  #   value: '^json$'
  # - key: readability-identifier-naming.ParameterCase
  #   value: lower_case
  # - key: readability-identifier-naming.ParameterIgnoredRegexp
  #   value: '^(fileName|plannerPython|schedulerPython|executorPython)$'
  # - key: readability-identifier-naming.LocalVariableCase
  #   value: lower_case
  # - key: readability-identifier-naming.PrivateMemberCase
  #   value: lower_case
  # - key: readability-identifier-naming.PrivateMemberSuffix
  #   value: _
  # - key: readability-identifier-naming.ConstantCase
  #   value: lower_case
  # - key: readability-identifier-naming.ConstantIgnoredRegexp
  #   value: '^[A-Z][A-Z0-9_]*$'
  # - key: readability-identifier-naming.StaticConstantCase
  #   value: CamelCase
  # - key: readability-identifier-naming.StaticConstantPrefix
  #   value: k
  # - key: readability-identifier-naming.MacroDefinitionCase
  #   value: UPPER_CASE
